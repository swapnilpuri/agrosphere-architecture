@startuml
!define RELATIVE_INCLUDE
!pragma layout smetana
!include includes/C4_Container.puml
Person(manager, "Manager")
System_Boundary(platform, "AgroSphere") {
Container(web, "Web", "Angular / CesiumJS / ECharts", "Estate viewer")
Container(ue, "Immersive", "Unreal / Cesium / OpenXR roadmap", "Same authoritative IDs")
Container(gateway, "API gateway", "Spring Cloud Gateway MVC", "JWT, routing, limits; no domain logic")
Container(estate, "estate-service", "Java 25 / Spring Boot", "Companies, estates, divisions, plantation blocks, crop/clone and planting metadata; canonical estateId and blockId. No geometry.")
ContainerDb(estatedb, "estate-service database", "PostgreSQL", "Separate role and migrations")
Container(spatial, "spatial-service", "Java 21 / Spring Boot", "GeoJSON boundaries, spatial searches, geospatial layers and georeferenced twin asset references. Canonical identities arrive through APIs/events; no estate identity ownership.")
ContainerDb(spatialdb, "spatial-service database", "PostgreSQL / PostGIS", "Separate role and migrations")
Container(operations, "operations-service", "Java 21 / Spring Boot", "Rubber tapping, latex collection, DRC, production calculations, inspections and crop-health incidents.")
ContainerDb(operationsdb, "operations-service database", "PostgreSQL", "Separate role and migrations")
Container(telemetry, "telemetry-service", "Java 21 / Spring Boot", "Device registry, MQTT ingestion, weather/soil readings, normalization and environmental anomaly events.")
ContainerDb(telemetrydb, "telemetry-service database", "PostgreSQL", "Separate role and migrations")
Container(analytics, "analytics-service", "Java 21 / Spring Boot", "Service-owned materialized KPI projections, productivity/yield summaries, dashboards and historical comparisons. No cross-database SQL.")
ContainerDb(analyticsdb, "analytics-service database", "PostgreSQL", "Separate role and migrations")
Container(ai, "ai-service", "Python / FastAPI", "Forecasting, anomaly analysis, assistant orchestration, model evaluation/versioning and evidence-backed recommendations.")
ContainerDb(aidb, "ai-service database", "PostgreSQL", "Separate role and migrations")
ContainerQueue(events, "Domain events", "RabbitMQ", "Versioned durable events")
ContainerQueue(mqtt, "IoT ingress", "Mosquitto MQTT", "Device transport")
Container(identity, "Identity", "Keycloak", "OIDC")
Container(otel, "Telemetry collector", "OpenTelemetry", "Local OTLP trace collection")
Container(jaeger, "Trace viewer", "Jaeger", "Ephemeral local trace retention")
}
Rel(manager, web, "Uses", "HTTPS")
Rel(manager, ue, "Uses")
Rel(web, gateway, "Calls", "REST / JWT")
Rel(ue, gateway, "Calls", "REST / JWT")
Rel(gateway, identity, "Discovers issuer / JWKS", "OIDC")
Rel(gateway, estate, "Routes authorized calls", "REST")
Rel(estate, estatedb, "Owns exclusively", "SQL")
Rel(estate, events, "Publish / consume selected contracts", "AMQP")
Rel(gateway, spatial, "Routes authorized calls", "REST")
Rel(spatial, spatialdb, "Owns exclusively", "SQL")
Rel(spatial, events, "Publish / consume selected contracts", "AMQP")
Rel(gateway, operations, "Routes authorized calls", "REST")
Rel(operations, operationsdb, "Owns exclusively", "SQL")
Rel(operations, events, "Publish / consume selected contracts", "AMQP")
Rel(gateway, telemetry, "Routes authorized calls", "REST")
Rel(telemetry, telemetrydb, "Owns exclusively", "SQL")
Rel(telemetry, events, "Publish / consume selected contracts", "AMQP")
Rel(gateway, analytics, "Routes authorized calls", "REST")
Rel(analytics, analyticsdb, "Owns exclusively", "SQL")
Rel(analytics, events, "Publish / consume selected contracts", "AMQP")
Rel(gateway, ai, "Routes authorized calls", "REST")
Rel(ai, aidb, "Owns exclusively", "SQL")
Rel(ai, events, "Publish / consume selected contracts", "AMQP")
Rel(mqtt, telemetry, "Normalized ingestion", "MQTT")
Rel(gateway, otel, "HTTP spans", "OTLP")
Rel(estate, otel, "HTTP and outbox producer spans", "OTLP")
Rel(spatial, otel, "HTTP and consumer/producer spans", "OTLP")
Rel(otel, jaeger, "Exports traces", "OTLP")
@enduml
