@startuml
!define RELATIVE_INCLUDE
!pragma layout smetana
!include includes/C4_Container.puml
Container(estate, "estate-service", "Independent repository", "Companies, estates, divisions, plantation blocks, crop/clone and planting metadata; canonical estateId and blockId. No geometry.")
ContainerDb(estatedb, "agrosphere_estate", "PostgreSQL", "Isolated credentials / migrations")
Rel(estate, estatedb, "Sole application owner")
Container(spatial, "spatial-service", "Independent repository", "GeoJSON boundaries, spatial searches, geospatial layers and georeferenced twin asset references. Canonical identities arrive through APIs/events; no estate identity ownership.")
ContainerDb(spatialdb, "agrosphere_spatial", "PostGIS", "Isolated credentials / migrations")
Rel(spatial, spatialdb, "Sole application owner")
Container(operations, "operations-service", "Independent repository", "Rubber tapping, latex collection, DRC, production calculations, inspections and crop-health incidents.")
ContainerDb(operationsdb, "agrosphere_operations", "PostgreSQL", "Isolated credentials / migrations")
Rel(operations, operationsdb, "Sole application owner")
Container(telemetry, "telemetry-service", "Independent repository", "Device registry, MQTT ingestion, weather/soil readings, normalization and environmental anomaly events.")
ContainerDb(telemetrydb, "agrosphere_telemetry", "PostgreSQL", "Isolated credentials / migrations")
Rel(telemetry, telemetrydb, "Sole application owner")
Container(analytics, "analytics-service", "Independent repository", "Service-owned materialized KPI projections, productivity/yield summaries, dashboards and historical comparisons. No cross-database SQL.")
ContainerDb(analyticsdb, "agrosphere_analytics", "PostgreSQL", "Isolated credentials / migrations")
Rel(analytics, analyticsdb, "Sole application owner")
Container(ai, "ai-service", "Independent repository", "Forecasting, anomaly analysis, assistant orchestration, model evaluation/versioning and evidence-backed recommendations.")
ContainerDb(aidb, "agrosphere_ai", "PostgreSQL", "Isolated credentials / migrations")
Rel(ai, aidb, "Sole application owner")
note "One local PostgreSQL server; separate databases. No cross-database queries, cross-service foreign keys or shared JPA entities. Estate/Spatial credential isolation is tested in M1C. Keycloak has its own database." as isolation
@enduml
